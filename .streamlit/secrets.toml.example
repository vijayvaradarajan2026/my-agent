# You do NOT need this file to start. The app runs in demo mode without it.
#
# To use a real AI model:
#   On your computer (Day 2): copy this file to .streamlit/secrets.toml and fill it in.
#   Online (Day 3): paste the same three lines into Streamlit's Advanced settings -> Secrets.
# Never upload .streamlit/secrets.toml to GitHub.

AI_API_KEY = "paste-your-key-here"

# Pick ONE provider and use its two lines (base url and model name):

# OpenAI
AI_BASE_URL = "https://api.openai.com/v1"
AI_MODEL = "gpt-4o-mini"

# Google Gemini (has a free tier)
# AI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
# AI_MODEL = "gemini-2.5-flash"

# DeepSeek
# AI_BASE_URL = "https://api.deepseek.com"
# AI_MODEL = "deepseek-chat"
